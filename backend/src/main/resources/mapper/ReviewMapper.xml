<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.floranest.backend.mapper.ReviewMapper">
    <resultMap id="reviewMap" type="Review">
        <id column="review_id" property="reviewId"/>
        <result column="user_id" property="userId"/>
        <result column="review_type" property="reviewType"/>
        <result column="target_name" property="targetName"/>
        <result column="author_name" property="authorName"/>
        <result column="rating" property="rating"/>
        <result column="comment" property="comment"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findAll" resultMap="reviewMap">
        SELECT * FROM reviews
        ORDER BY created_at DESC, review_id DESC;
    </select>

    <select id="findById" parameterType="int" resultMap="reviewMap">
        SELECT * FROM reviews WHERE review_id = #{reviewId};
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="reviewId">
        INSERT INTO reviews
        (
        user_id,
        review_type,
        target_name,
        author_name,
        rating,
        comment
        )
        VALUES
        (
        #{userId},
        #{reviewType},
        #{targetName},
        #{authorName},
        #{rating},
        #{comment}
        )
    </insert>

    <delete id="delete">
        DELETE FROM reviews WHERE review_id=#{reviewId};
    </delete>

</mapper>
